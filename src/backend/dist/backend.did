type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type SlackPostResult = 
 record {
   channel: text;
   error: opt text;
   ok: bool;
   ts: text;
 };
type SlackError = 
 record {
   code: text;
   message: text;
 };
type SlackChannel = 
 record {
   id: text;
   isArchived: bool;
   isChannel: bool;
   isPrivate: bool;
   name: text;
   numMembers: opt nat;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PostMessageResult = 
 variant {
   err: SlackError;
   ok: SlackPostResult;
 };
type ListChannelsResult = 
 variant {
   err: SlackError;
   ok: vec SlackChannel;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  clearSlackToken: () -> ();
  execute: (qJson: text) -> (Result) query;
  getCallerUserRole: () -> (UserRole) query;
  hasSlackToken: () -> (bool) query;
  isCallerAdmin: () -> (bool) query;
  listSlackChannels: () -> (ListChannelsResult);
  postSlackMessage: (channel: text, "text": text) -> (PostMessageResult);
  saveSlackToken: (token: text) -> ();
  schema: () -> (text) query;
}
